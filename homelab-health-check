#!/usr/bin/env bash
# Her 10 dakikada bir çalışır; yeni sorun çıkınca ve düzelince ntfy ile haber verir (tekrar tekrar uyarmaz).
set -uo pipefail
STATE_DIR=/var/lib/homelab-installer
STATE="$STATE_DIR/health-state"
NOTIFY=/usr/local/sbin/homelab-notify
install -d -m 0700 "$STATE_DIR"
declare -A NOW=()
add_problem() { NOW["$1"]="$2"; }

# 1) Disk doluluğu
declare -A SEEN_MOUNT=()
for MP in / /srv/homelab; do
  TARGET="$(df -P "$MP" 2>/dev/null | awk 'NR==2 {print $6}')"
  [[ -n "$TARGET" && -z "${SEEN_MOUNT[$TARGET]:-}" ]] || continue
  SEEN_MOUNT["$TARGET"]=1
  USE="$(df -P "$MP" 2>/dev/null | awk 'NR==2 {gsub("%","",$5); print $5}')"
  if [[ "$USE" =~ ^[0-9]+$ ]] && ((USE >= 90)); then add_problem "disk:$TARGET" "Disk %$USE dolu: $TARGET"; fi
done
# 2) Başarısız systemd birimleri
while read -r UNIT; do
  [[ -n "$UNIT" ]] && add_problem "unit:$UNIT" "Servis başarısız: $UNIT"
done < <(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}')
# 3) Bilinen konteynerler çalışmıyor
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  for C in dockge beszel beszel-agent uptime-kuma scrutiny filebrowser ollama n8n caddy adguardhome ntfy; do
    STATUS="$(docker inspect --format '{{.State.Status}}' "$C" 2>/dev/null || true)"
    [[ -n "$STATUS" && "$STATUS" != running ]] && add_problem "container:$C" "Konteyner çalışmıyor: $C ($STATUS)"
  done
fi
# 4) Yedek 48 saatten eski
if [[ -f /etc/restic/homelab.env ]]; then
  LAST="$(systemctl show homelab-restic-backup.service -p ExecMainExitTimestamp --value 2>/dev/null || true)"
  if [[ -n "$LAST" ]]; then
    LAST_EPOCH="$(date -d "$LAST" +%s 2>/dev/null || echo 0)"
    if ((LAST_EPOCH > 0)) && (( $(date +%s) - LAST_EPOCH > 172800 )); then add_problem "backup:stale" "Son yedek 48 saatten eski ($LAST)"; fi
  fi
fi

declare -A OLD=()
if [[ -f "$STATE" ]]; then
  while IFS='|' read -r KEY MSG; do [[ -n "$KEY" ]] && OLD["$KEY"]="$MSG"; done < "$STATE"
fi
declare -A NEW=()
for KEY in "${!NOW[@]}"; do
  if [[ -n "${OLD[$KEY]:-}" ]]; then
    NEW["$KEY"]="${NOW[$KEY]}"
  elif "$NOTIFY" "HomeLab: sorun" "${NOW[$KEY]}" 4 warning; then
    NEW["$KEY"]="${NOW[$KEY]}"
  fi   # bildirim gitmediyse kaydetme; sonraki çalıştırmada tekrar denenir
done
for KEY in "${!OLD[@]}"; do
  if [[ -z "${NOW[$KEY]:-}" ]]; then
    "$NOTIFY" "HomeLab: düzeldi" "${OLD[$KEY]} — sorun giderildi" 3 white_check_mark || NEW["$KEY"]="${OLD[$KEY]}"
  fi
done
TMP="$(mktemp "$STATE_DIR/.health.XXXXXX")"
for KEY in "${!NEW[@]}"; do printf '%s|%s\n' "$KEY" "${NEW[$KEY]}" >> "$TMP"; done
chmod 0600 "$TMP"; mv -f "$TMP" "$STATE"
